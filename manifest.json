{
  "manifest_version": 3,
  "name": "GitHub Repositories for ChatGPT",
  "version": "1.4.0",
  "description": "Adds a personalized GitHub repository dashboard and optional ChatGPT interface tweaks.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js",
        "external-links.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
