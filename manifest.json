{
  "manifest_version": 3,
  "name": "GitHub Repositories for ChatGPT",
  "version": "1.5.0",
  "description": "Adds a personalized GitHub repository dashboard and optional ChatGPT interface tweaks.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "GitHub Repositories for ChatGPT",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "styles.css",
        "owner-grid.css"
      ],
      "js": [
        "content.js",
        "external-links.js",
        "owner-grid.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
